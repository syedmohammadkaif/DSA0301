import re
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
def evaluate_coherence(text):
    sentences = re.split(r'[.!?]+', text)
    sentences = [s.strip() for s in sentences if s.strip()]
    if len(sentences) < 2:
        print("At least two sentences are required.")
        return
    vectorizer = TfidfVectorizer(stop_words='english')
    tfidf_matrix = vectorizer.fit_transform(sentences)
    similarities = []
    for i in range(len(sentences) - 1):
        similarity = cosine_similarity(
            tfidf_matrix[i:i+1],
            tfidf_matrix[i+1:i+2]
        )[0][0]
        similarities.append(similarity)
    coherence_score = sum(similarities) / len(similarities)
    print("\n--- Coherence Evaluation ---")
    for i, score in enumerate(similarities):
        print(
            f"Similarity between Sentence {i+1} "
            f"and Sentence {i+2}: {score:.2f}"
        )
    print(f"\nOverall Coherence Score: {coherence_score:.2f}")
    if coherence_score >= 0.60:
        print("Coherence Level: HIGH")
    elif coherence_score >= 0.30:
        print("Coherence Level: MEDIUM")
    else:
        print("Coherence Level: LOW")
text = input("Enter the text:\n")

evaluate_coherence(text)
